# The recipes of the pinned tool environment (`tools/`).
# Generated; propose changes in an issue rather than editing this file.
#
# A just module (`mod tools`): its recipes cannot collide with a project's own, and it reads no
# variable of the importing justfile, so per-project values arrive as recipe arguments.
# Paths below are relative to the repository root, the working directory set here.
set working-directory := '..'

# Runs a tool from the toolbox, syncing its environment on demand. `--locked` fails when
# tools/pyproject.toml is ahead of tools/uv.lock. `env -u VIRTUAL_ENV` silences uv's warning about
# an activated .venv. `UV_PROJECT_ENVIRONMENT` (relative to `tools/`) puts the environment at
# `.venv-tools` beside `.venv`; it is not exported, or `just venv` would sync there too.
tools := "env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv run --locked --project tools"

[doc("Install the host tools (uv, just, prek), build the pinned tool environment (tools/), and install the commit hooks")]
doctor:
    brew install uv just prek
    env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv sync --locked --project tools
    prek install

# A tool that must stay below a release says so in tools/pyproject.toml as a requirement ceiling.
[doc("Upgrade the locked tool versions within tools/pyproject.toml's constraints, then rebuild .venv-tools")]
upgrade:
    uv lock --project tools --upgrade
    env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv sync --project tools

# Session names carry quotes and parentheses (`tests(python='3.14t')`), so arguments are not split.
[positional-arguments]
[doc("Run nox from the pinned tool environment (tools/): `just tools nox --list`")]
nox *args:
    {{ tools }} nox "$@"

# A session tagged `windows` runs on windows-latest; one tagged `optional` may fail without failing
# the run. No session is an error: GitHub reports a workflow with an empty matrix as passed.
[doc("Print the noxfile's sessions tagged `ci` as a GitHub Actions matrix (fails when there are none)")]
ci-matrix:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ tools }} nox --tags ci --list --json | {{ tools }} python -c '
    import json, sys
    sessions = json.load(sys.stdin)
    if not sessions:
        sys.exit("ci-matrix: no noxfile session is tagged `ci`")
    include = [
        {
            "session": s["session"],
            "os": "windows-latest" if "windows" in s["tags"] else "ubuntu-latest",
            "optional": "optional" in s["tags"],
        }
        for s in sessions
    ]
    print(json.dumps({"include": include}))
    '

[doc("Run any tool from the pinned tool environment (tools/): `just tool toolbox ty -- <path>`")]
run *args:
    {{ tools }} {{ args }}

# `.pre-commit-config.yaml` pins the linters and `tools/uv.lock` everything else.
[doc("Report every tool version in force, and which could move (read-only)")]
pins:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "▸ commit hooks — .pre-commit-config.yaml (what prek and pre-commit.ci run)"
    awk '$1=="-" && $2=="repo:" {repo=$3}
         $1=="rev:" {n=split(repo, seg, "/"); gsub(/"/, "", $2); printf "  %-26s %s\n", seg[n], $2}' \
        .pre-commit-config.yaml
    echo "  hook revs are updated by the maintainers; 'just frozen-revs' checks the pinned ones"
    echo
    echo "▸ tools — tools/uv.lock (what every recipe that runs a tool runs)"
    {{ tools }} python - <<'PY'
    import pathlib, re, tomllib

    requirements = tomllib.loads(pathlib.Path("tools/pyproject.toml").read_text())["project"]["dependencies"]
    locked = {p["name"]: p["version"] for p in tomllib.loads(pathlib.Path("tools/uv.lock").read_text())["package"]}
    for requirement in requirements:
        name = re.split(r"[\s<>=!~\[]", requirement, maxsplit=1)[0]
        version = locked.get(name.lower().replace("_", "-"), "?")
        print(f"  {name:<26} {version:<10} ({requirement})")
    PY
    echo
    echo "▸ what could move inside those constraints (dry run — nothing is written)"
    env -u VIRTUAL_ENV uv lock --project tools --upgrade --dry-run

# `prek update` moves every rev, including one pinned on purpose. An entry is the last segment of a
# hook repository's URL, matched whole; one whose hook is gone reports not found.
[doc("Verify the given pre-commit revs (a <repo>=<rev> list) have not moved")]
frozen-revs revs:
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    IFS=',' read -ra frozen <<< "{{ revs }}"
    for entry in "${frozen[@]}"; do
        [ -n "$entry" ] || continue
        repo="${entry%%=*}"
        want="${entry#*=}"
        got=$(awk -v r="$repo" \
            '$1=="-" && $2=="repo:" {n = split($3, part, "/"); cur = (part[n] == r)}
             cur && $1=="rev:" {print $2; exit}' \
            .pre-commit-config.yaml)
        if [ "$got" != "$want" ]; then
            echo "frozen rev moved: $repo pinned to $want, config says ${got:-<not found>}" >&2
            echo "  the reason it is frozen is commented next to the hook in .pre-commit-config.yaml;" >&2
            echo "  revert the rev, or drop the entry from the list if it no longer applies." >&2
            status=1
        fi
    done
    [ "$status" -eq 0 ] && echo "frozen revs intact: ${frozen[*]}"
    exit "$status"

[doc("Check the rules in CONVENTIONS.md, then the repository's own checks")]
conventions:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ tools }} conventions check
    if compgen -G 'tools/checks/*_check.py' >/dev/null; then
        {{ tools }} pytest -c tools/pyproject.toml --rootdir . tools/checks -q
    else
        echo "conventions: no tools/checks/*_check.py of this repository's own"
    fi

# A rename that would shadow or collide is refused and printed.
[doc("Apply the visibility renames CON402 and CON403 ask for")]
fix-visibility:
    {{ tools }} conventions fix CON402 CON403

# mypy from the toolbox analyses the toolbox's interpreter, which these files run on, and reads the
# repository's `mypy.ini`. `tools/conventions/` is generated and excluded.
[doc("Type-check the repository's own checks (mypy, blocking)")]
types:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! compgen -G 'tools/checks/*.py' >/dev/null; then
        echo "tools::types: no tools/checks/ of this repository's own"
        exit 0
    fi
    env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv run --locked --project tools mypy tools/checks


# --- Structure ---
#
# Each takes the directory holding the package's `pyproject.toml` (`.` at the root) and reads its
# configuration from there.

# The toolbox by absolute path, for recipes that change into a package's directory.
tools_at := "env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv run --locked --project " + source_directory()

# import-linter finds the package from the directory it runs in. A distribution that declares no
# contracts is skipped.
[doc("Check import-graph contracts (import-linter) for the package in DIR")]
imports dir:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ dir }}
    if ! grep -q '^\[tool\.importlinter\]' pyproject.toml; then
        echo "imports: {{ dir }}/pyproject.toml declares no [tool.importlinter] contracts"
        exit 0
    fi
    {{ tools_at }} lint-imports

# deptry and slotscheck run in the project's `.venv`, from its `lint` group: slotscheck imports the
# package, and deptry reads the installed distributions of its interpreter. `--no-sync`: `just venv`
# builds that environment, and a check does not install tools.
[doc("Check declared dependencies against imports (deptry) for PACKAGE in DIR")]
deps dir package:
    cd {{ dir }} && env -u VIRTUAL_ENV uv run --no-sync deptry {{ package }}

[doc("Check __slots__ across the class hierarchy (slotscheck) for PACKAGE in DIR")]
slots dir package:
    cd {{ dir }} && env -u VIRTUAL_ENV uv run --no-sync slotscheck -m {{ package }}

# vulture reads `[tool.vulture]` from the directory it runs in.
[doc("Find unused code (vulture) with DIR's configuration; extra ARGS go to vulture")]
deadcode dir *args:
    cd {{ dir }} && {{ tools_at }} vulture {{ args }}

# --- Check and fix ---

# `toolbox` turns the optional paths into the files the hooks judge: the working tree (tracked and
# new files) when none, a directory as the files git shows under it, and a path that names nothing
# is refused with exit 2. Nothing writes to git's index.
#
# mypy runs only for named paths (the type recipes judge the whole tree), skips non-Python files,
# and checks a `typing_tests/` suite as package code. It runs whatever the hooks said.
[doc("Read-only check: every applicable commit hook, plus mypy for Python paths. No paths = whole tree.")]
check *paths:
    #!/usr/bin/env bash
    status=0
    {{ tools }} toolbox prek -- {{ paths }} || status=$?
    if [ -z "{{ paths }}" ]; then
        echo "mypy: skipped for a whole-tree run; 'just gate' runs the type checks"
    else
        {{ tools }} toolbox mypy -- {{ paths }} || status=$?
    fi
    exit "$status"

# Only exit code 2 (a refused path) is read: a fixing hook exits non-zero when it fixed something.
[doc("Apply every fixer whose finding the PR checks (`just gate`) can only report. `check` and `gate` never write.")]
fix *paths:
    #!/usr/bin/env bash
    {{ tools }} toolbox prek --stage manual -- {{ paths }}
    [ $? -eq 2 ] && exit 2
    echo
    echo "fixed what could be fixed. 'just check' reports what is left."
