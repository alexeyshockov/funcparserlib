# The benchmark recipes: a module of the root justfile, reached as `just bench::<recipe>`.
# Generated; propose changes in an issue rather than editing this file.
#
# The micro-benchmarks are the `bench_*.py` files of each distribution's `benchmarks/` directory.
# They run in the noxfile's `bench` sessions under `pytest.ini` beside this file; the session
# tagged `bench` is the default.

set working-directory := '..'

# Variables are evaluated when a recipe uses them, so the lookups below cost nothing elsewhere.
set lazy

tools := "env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv run --locked --project tools"
dists := `env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT=../.venv-tools uv run --locked --project tools conventions packages --dirs`
bench_dirs := shell('for d in $1; do b=$([ "$d" = . ] && echo benchmarks || echo "$d/benchmarks"); [ -d "$b" ] && printf "%s " "$b"; done; true', dists)

# Another interpreter's session runs by name:
# `just tools::nox -s "bench(python='3.14')" -- benchmarks`.
[doc("Run the micro-benchmarks in the noxfile's sessions tagged `bench`, every distribution's or DIST's; the other arguments go to pytest")]
[positional-arguments]
micro *args:
    #!/usr/bin/env bash
    set -euo pipefail
    dirs=({{ bench_dirs }})
    if [ $# -gt 0 ] && [ -d "$1/benchmarks" ]; then dirs=("$1/benchmarks"); shift; fi
    [ ${#dirs[@]} -gt 0 ] || { echo "no benchmarks/ directory to run"; exit 1; }
    {{ tools }} nox --tags bench --list --json | {{ tools }} python -c '
    import json, sys
    if not json.load(sys.stdin):
        sys.exit(
            "bench::micro: no noxfile session is tagged `bench`; add the `bench` session of the"
            " template noxfile to this project'"'"'s noxfile.py"
        )
    '
    exec {{ tools }} nox --tags bench -- -c benchmarks/pytest.ini "${dirs[@]}" "$@"

[doc("Compare saved runs, by default the two newest of one machine and interpreter; the table also goes to benchmarks/results/compare.csv")]
[positional-arguments]
compare *runs:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ $# -eq 0 ]; then
        # The two newest runs in the newest run's directory (one machine and interpreter).
        newest=$(ls -t benchmarks/results/*/*.json 2>/dev/null | head -n 1)
        [ -n "$newest" ] || { echo "no saved runs under benchmarks/results/"; exit 1; }
        set -- $(ls -t "$(dirname "$newest")"/*.json | head -n 2)
    fi
    exec uv run --no-sync pytest-benchmark --storage file://benchmarks/results compare \
        --csv=benchmarks/results/compare "$@"
