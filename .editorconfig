# Generated; propose changes in an issue rather than editing this file.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# The width also applies to Rust, so `cargo fmt` uses the same ruler.
[*.{py,toml,rs}]
indent_size = 4
max_line_length = 100

[justfile]
indent_size = 4

# Prose is not reflowed to 100.
[*.md]
indent_size = 4
max_line_length = 120

[*.{yaml,yml,json,sh}]
indent_size = 2
max_line_length = 120
